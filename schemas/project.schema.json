{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightthecandle.dev/schemas/project.v1.json",
  "title": "Light the Candle project",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "slug",
    "name",
    "project_type",
    "quality_profile",
    "policy",
    "created_at",
    "strategy",
    "lifecycle",
    "commands",
    "technologies",
    "adapters"
  ],
  "properties": {
    "schema_version": {
      "const": "lightthecandle.project/v1"
    },
    "project_id": {
      "type": "string",
      "format": "uuid"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "pattern": "\\S"
    },
    "description": {
      "type": "string"
    },
    "project_type": {
      "enum": [
        "web",
        "mobile",
        "api",
        "library",
        "cli",
        "desktop",
        "data",
        "infrastructure",
        "monorepo",
        "generic"
      ]
    },
    "quality_profile": {
      "enum": ["prototype", "quality", "production", "enterprise"]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "profile", "sha256"],
      "properties": {
        "schema_version": {
          "const": "lightthecandle.policy/v1"
        },
        "profile": {
          "enum": ["prototype", "quality", "production", "enterprise"]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "strategy": {
      "$ref": "./strategy.schema.json"
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_stage", "enabled_stages"],
      "properties": {
        "current_stage": {
          "enum": [
            "idea",
            "discovery",
            "feasibility",
            "requirements",
            "product_design",
            "architecture",
            "security_privacy_data",
            "planning",
            "implementation",
            "verification",
            "release",
            "deployment",
            "operations",
            "maintenance",
            "incident_response",
            "retrospective",
            "retirement"
          ]
        },
        "enabled_stages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "idea",
              "discovery",
              "feasibility",
              "requirements",
              "product_design",
              "architecture",
              "security_privacy_data",
              "planning",
              "implementation",
              "verification",
              "release",
              "deployment",
              "operations",
              "maintenance",
              "incident_response",
              "retrospective",
              "retirement"
            ]
          },
          "uniqueItems": true
        }
      },
      "oneOf": [
        {
          "properties": {
            "current_stage": {"const": "idea"},
            "enabled_stages": {"contains": {"const": "idea"}}
          }
        },
        {
          "properties": {
            "current_stage": {"const": "discovery"},
            "enabled_stages": {"contains": {"const": "discovery"}}
          }
        },
        {
          "properties": {
            "current_stage": {"const": "feasibility"},
            "enabled_stages": {"contains": {"const": "feasibility"}}
          }
        },
        {
          "properties": {
            "current_stage": {"const": "requirements"},
            "enabled_stages": {"contains": {"const": "requirements"}}
          }
        },
        {
          "properties": {
            "current_stage": {"const": "product_design"},
            "enabled_stages": {"contains": {"const": "product_design"}}
          }
        },
        {
          "properties": {
            "current_stage": {"const": "architecture"},
            "enabled_stages": {"contains": {"const": "architecture"}}
          }
        },
        {
          "properties": {
            "current_stage": {"const": "security_privacy_data"},
            "enabled_stages": {"contains": {"const": "security_privacy_data"}}
          }
        },
        {
          "properties": {
            "current_stage": {"const": "planning"},
            "enabled_stages": {"contains": {"const": "planning"}}
          }
        },
        {
          "properties": {
            "current_stage": {"const": "implementation"},
            "enabled_stages": {"contains": {"const": "implementation"}}
          }
        },
        {
          "properties": {
            "current_stage": {"const": "verification"},
            "enabled_stages": {"contains": {"const": "verification"}}
          }
        },
        {
          "properties": {
            "current_stage": {"const": "release"},
            "enabled_stages": {"contains": {"const": "release"}}
          }
        },
        {
          "properties": {
            "current_stage": {"const": "deployment"},
            "enabled_stages": {"contains": {"const": "deployment"}}
          }
        },
        {
          "properties": {
            "current_stage": {"const": "operations"},
            "enabled_stages": {"contains": {"const": "operations"}}
          }
        },
        {
          "properties": {
            "current_stage": {"const": "maintenance"},
            "enabled_stages": {"contains": {"const": "maintenance"}}
          }
        },
        {
          "properties": {
            "current_stage": {"const": "incident_response"},
            "enabled_stages": {"contains": {"const": "incident_response"}}
          }
        },
        {
          "properties": {
            "current_stage": {"const": "retrospective"},
            "enabled_stages": {"contains": {"const": "retrospective"}}
          }
        },
        {
          "properties": {
            "current_stage": {"const": "retirement"},
            "enabled_stages": {"contains": {"const": "retirement"}}
          }
        }
      ]
    },
    "commands": {
      "type": "object",
      "propertyNames": {
        "pattern": "\\S"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    },
    "technologies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "adapters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability", "provider", "mode"],
        "properties": {
          "capability": {
            "type": "string",
            "pattern": "\\S"
          },
          "provider": {
            "type": "string",
            "pattern": "\\S"
          },
          "mode": {"enum": ["read_only", "disabled"]}
        }
      }
    }
  }
}
