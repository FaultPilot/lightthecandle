{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightthecandle.dev/schemas/project.v1.json",
  "title": "Light the Candle project",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "slug",
    "name",
    "project_type",
    "quality_profile",
    "policy",
    "created_at",
    "strategy",
    "lifecycle",
    "commands",
    "technologies",
    "adapters"
  ],
  "properties": {
    "schema_version": {
      "const": "lightthecandle.project/v1"
    },
    "project_id": {
      "type": "string",
      "format": "uuid"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "project_type": {
      "enum": [
        "web",
        "mobile",
        "api",
        "library",
        "cli",
        "desktop",
        "data",
        "infrastructure",
        "monorepo",
        "generic"
      ]
    },
    "quality_profile": {
      "enum": ["prototype", "quality", "production", "enterprise"]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "profile", "sha256"],
      "properties": {
        "schema_version": {
          "const": "lightthecandle.policy/v1"
        },
        "profile": {
          "enum": ["prototype", "quality", "production", "enterprise"]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "strategy": {
      "$ref": "./strategy.schema.json"
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_stage", "enabled_stages"],
      "properties": {
        "current_stage": {
          "type": "string"
        },
        "enabled_stages": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {"type": "string"}
      }
    },
    "technologies": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "adapters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability", "provider", "mode"],
        "properties": {
          "capability": {"type": "string"},
          "provider": {"type": "string"},
          "mode": {"enum": ["read_only", "disabled"]}
        }
      }
    }
  }
}
