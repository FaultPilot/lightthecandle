{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightthecandle.dev/schemas/strategy.v1.json",
  "title": "Light the Candle strategy seed",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "purpose",
    "outcomes",
    "success_measures",
    "assumptions",
    "constraints",
    "decision_principles",
    "review_triggers"
  ],
  "properties": {
    "purpose": {
      "type": "string",
      "anyOf": [
        {"maxLength": 0},
        {"pattern": "\\S"}
      ]
    },
    "outcomes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    },
    "success_measures": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    },
    "decision_principles": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    },
    "review_triggers": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    }
  }
}
